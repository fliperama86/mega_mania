# build output
*.o
*.elf
*.lst
*.map
*.bin
*.32x
out.*

# converted assets: derived from the user's own copy of the game, regenerate
# with tools/convert_stage.py rather than committing Sega's artwork
assets/

# tools/gen_assets.py's output: computed from that script's own manifest and
# the asset .bin files above, regenerated by game/Makefile on every build --
# see that Makefile's assets_gen.stamp rule.
game/md_src/assets_gen.h
game/sh_src/assets_gen.s
game/sh_src/mars_gen_mem.ld
game/sh_src/mars_gen_sections.ld
game/assets_gen.stamp

__pycache__/

# compiler-generated header dependency files (Makefile -MMD)
game/md_src/*.d
game/sh_src/*.d
game/cd_src/*.d
